# Salin jadi .env (buat `vercel dev` lokal). JANGAN commit file .env
# yang sudah diisi -- di Vercel production, isi env var yang sama ini
# lewat Project Settings > Environment Variables (bukan lewat file).

# Comma-separated, domain pertama = default. Tambah domain baru
# tinggal nambah di sini (pastiin Worker am-gen-mail udah nerima
# email domain itu juga, lihat setup Cloudflare Email Routing).
EMAIL_DOMAINS=hiyorimail.biz.id,bayzstore.biz.id

# WAJIB SAMA PERSIS dengan LINK_SIGNING_SECRET di project
# generator-hiyorimail (Vercel Environment Variables project itu).
LINK_SIGNING_SECRET=

GENERATOR_BASE_URL=https://generator.hiyorimail.biz.id

# https://am-gen-mail.<subdomain-akun-cf-kamu>.workers.dev/delete
WORKER_DELETE_URL=

# Secret BEBAS (random, panjang) khusus buat nge-sign cookie sesi
# login di project web ini. HARUS BEDA dari LINK_SIGNING_SECRET.
# Generate contoh: openssl rand -hex 32
COOKIE_SECRET=

# SAMA PERSIS dengan punya project generator-hiyorimail -- dipakai
# bareng biar riwayat email tersimpan terpusat (KV), bukan lagi di
# cookie browser, jadi kebaca dari device manapun setelah login.
# Token butuh izin "Workers KV Storage: Edit".
CF_ACCOUNT_ID=
CF_NAMESPACE_ID=
CF_API_TOKEN=

# Login 1 akun doang, gak ada register. Opsional -- kalau kosong,
# default-nya username "yori" password "owner".
AUTH_USERNAME=
AUTH_PASSWORD=

LOCAL_PART_LENGTH=12
COOLDOWN_SECONDS=5
HISTORY_LIMIT=5
SESSION_MAX_AGE_DAYS=365
